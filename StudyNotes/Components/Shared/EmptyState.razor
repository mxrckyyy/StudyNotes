<MudPaper Class="pa-8 d-flex flex-column align-center justify-center my-6" Elevation="0" Outlined="true" Style="border-radius: 12px; min-height: 250px;">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
    <MudText Typo="Typo.h6" Class="font-weight-bold">@Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">@Message</MudText>

    @if (ShowButton)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnButtonClick">@ButtonText</MudButton>
    }
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Notes;
    [Parameter] public string Title { get; set; } = "No Data";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public bool ShowButton { get; set; } = false;
    [Parameter] public string ButtonText { get; set; } = "Action";
    [Parameter] public EventCallback OnButtonClick { get; set; }
}