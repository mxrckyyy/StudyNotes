<div class="sn-empty">
    <div class="sn-empty-icon">
        <MudIcon Icon="@Icon" Size="Size.Large" />
    </div>
    <div class="sn-empty-title">@Title</div>
    <MudText Typo="Typo.body2" Class="sn-empty-message" Align="Align.Center">@Message</MudText>

    @if (ShowButton)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnButtonClick">@ButtonText</MudButton>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Notes;
    [Parameter] public string Title { get; set; } = "No Data";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public bool ShowButton { get; set; } = false;
    [Parameter] public string ButtonText { get; set; } = "Action";
    [Parameter] public EventCallback OnButtonClick { get; set; }
}