<MudPaper Elevation="0" Outlined="true" Class="sn-card sn-card-hover sn-stat-card">
    <div>
        <div class="sn-stat-label">@Title</div>
        <div class="sn-stat-value">@Value</div>
    </div>
    <div class="sn-stat-icon @(ToneCss)">
        <MudIcon Icon="@Icon" Size="Size.Medium" />
    </div>
</MudPaper>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Description;
    [Parameter] public string Tone { get; set; } = "primary";

    private string ToneCss => Tone switch
    {
        "warning" => "sn-tone-warning",
        "success" => "sn-tone-success",
        _ => string.Empty
    };

    // React.memo equivalent: skip re-rendering when the input parameters
    // (all primitives) have not changed, so sidebar/theme toggles in the
    // layout do not rebuild the stat cards on the dashboard.
    private int _lastValue;
    private string _lastTitle = string.Empty;
    private string _lastIcon = string.Empty;
    private string _lastTone = string.Empty;

    protected override bool ShouldRender()
    {
        if (_lastValue == Value && _lastTitle == Title && _lastIcon == Icon && _lastTone == Tone)
        {
            return false;
        }

        _lastValue = Value;
        _lastTitle = Title;
        _lastIcon = Icon;
        _lastTone = Tone;
        return true;
    }
}