<MudPaper Elevation="0" Outlined="true" Class="sn-card sn-card-hover sn-stat-card">
    <div>
        <div class="sn-stat-label">@Title</div>
        <div class="sn-stat-value">@Value</div>
    </div>
    <div class="sn-stat-icon @(ToneCss)">
        <MudIcon Icon="@Icon" Size="Size.Medium" />
    </div>
</MudPaper>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Description;
    [Parameter] public string Tone { get; set; } = "primary";

    private string ToneCss => Tone switch
    {
        "warning" => "sn-tone-warning",
        "success" => "sn-tone-success",
        _ => string.Empty
    };
}