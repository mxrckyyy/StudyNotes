@inject NoteService NoteService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Elevation="0" Outlined="true" Class="@CardClass" @onclick="ViewNote">
    <MudCardContent Class="pa-4 d-flex flex-column flex-grow-1" Style="padding-bottom: 8px;">
        <div class="d-flex justify-space-between align-start gap-2 mb-2">
            <MudText Typo="Typo.h6" Class="sn-note-title sn-clamp-2">@Note.Title</MudText>
            <div class="d-flex flex-shrink-0">
                <MudIconButton Icon="@(Note.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                               Color="@(Note.IsPinned ? Color.Primary : Color.Default)"
                               OnClick="TogglePin" ClickPropagation="false" Size="Size.Small"
                               title="@(Note.IsPinned ? "Unpin note" : "Pin note")" />
                <MudIconButton Icon="@(Note.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                               Color="@(Note.IsFavorite ? Color.Warning : Color.Default)"
                               OnClick="ToggleFavorite" ClickPropagation="false" Size="Size.Small"
                               title="@(Note.IsFavorite ? "Remove from favorites" : "Add to favorites")" />
            </div>
        </div>

        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="mb-3 align-self-start">
            @(Note.Subject?.Name ?? "Unassigned")
        </MudChip>

        <MudText Typo="Typo.body2" Class="sn-note-body flex-grow-1">
            @(Note.Content.Length > 120 ? Note.Content.Substring(0, 120) + "..." : Note.Content)
        </MudText>
    </MudCardContent>

    <MudCardActions Class="px-4 py-3">
        <div class="d-flex justify-space-between align-center w-100">
            <MudText Typo="Typo.caption" Class="sn-note-meta">Updated @Note.UpdatedAt.ToString("MMM d, yyyy")</MudText>
            <div class="sn-actions d-flex">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="EditNote" ClickPropagation="false" title="Edit note" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="DeleteNote" ClickPropagation="false" Class="sn-action-danger" title="Delete note" />
            </div>
        </div>
    </MudCardActions>
</MudCard>

@code {
    private string CardClass => Note.IsPinned
        ? "sn-card sn-card-hover sn-note-card sn-note-pinned"
        : "sn-card sn-card-hover sn-note-card";

    [Parameter] public Note Note { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    // React.memo equivalent: only re-render when the Note instance or the
    // OnChanged callback actually changes, so layout state toggles (sidebar,
    // theme) do not rebuild every note card on the page.
    private Note? _lastNote;
    private bool _lastHasCallback;

    protected override bool ShouldRender()
    {
        var hasCallback = OnChanged.HasDelegate;
        if (ReferenceEquals(_lastNote, Note) && _lastHasCallback == hasCallback)
        {
            return false;
        }

        _lastNote = Note;
        _lastHasCallback = hasCallback;
        return true;
    }

    private async Task TogglePin()
    {
        await NoteService.TogglePinAsync(Note.Id);
        Snackbar.Add(Note.IsPinned ? "? Note unpinned." : "? Note pinned.", Severity.Info);
        await OnChanged.InvokeAsync();
    }

    private async Task ToggleFavorite()
    {
        await NoteService.ToggleFavoriteAsync(Note.Id);
        Snackbar.Add(Note.IsFavorite ? "? Removed from favorites." : "? Added to favorites.", Severity.Info);
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteNote()
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete \"{Note.Title}\"? This action cannot be undone.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Note?", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await NoteService.DeleteNoteAsync(Note.Id);
            Snackbar.Add("? Note deleted.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
    }

    private void ViewNote() => Navigation.NavigateTo($"/notes/{Note.Id}");
    private void EditNote() => Navigation.NavigateTo($"/notes/{Note.Id}/edit");
}
