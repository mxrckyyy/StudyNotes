@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Top App Bar -->
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">StudyNotes</MudText>
        <MudSpacer />
    </MudAppBar>

    <!-- Slide-Out Navigation Drawer -->
    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Elevation="2" Variant="DrawerVariant.Temporary" Style="transition: transform 0.3s ease-in-out;">
        <div class="d-flex flex-column h-100">
            <!-- Header Section -->
            <div class="d-flex align-center justify-space-between px-4 py-3" style="min-height: 56px;">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">
                    StudyNotes
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" OnClick="@CloseDrawer" Size="Size.Small" />
            </div>

            <MudDivider />

            <!-- Navigation Links Component -->
            <div class="flex-grow-1 d-flex flex-column" style="overflow-y: auto;">
                <NavMenu OnLinkClick="@CloseDrawer" />
            </div>
        </div>
    </MudDrawer>

    <!-- Main Content Body -->
    <MudMainContent Style="padding-top: 80px; padding-left: 24px; padding-right: 24px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }
}