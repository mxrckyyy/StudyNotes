@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_darkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Top App Bar -->
    <MudAppBar Elevation="0" Class="sn-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" title="Toggle navigation" />
        <div class="d-flex align-center my-auto ml-2">
            <div class="sn-brand-mark">S</div>
            <span class="sn-brand-name">StudyNotes</span>
        </div>
        <MudSpacer />
        <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.DarkMode)"
                       Color="Color.Default"
                       OnClick="@ToggleTheme"
                       title="@(_darkMode ? "Switch to light mode" : "Switch to dark mode")" />
    </MudAppBar>

    <!-- Slide-Out Navigation Drawer -->
    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.Left" Elevation="0" Variant="DrawerVariant.Temporary" Class="sn-drawer">
        <div class="d-flex flex-column h-100">
            <!-- Keyline header -->
            <div class="sn-drawer-header d-flex align-center justify-space-between">
                <div class="d-flex align-center">
                    <div class="sn-brand-mark">S</div>
                    <div class="d-flex flex-column my-auto">
                        <span class="sn-brand-name">StudyNotes</span>
                        <span class="sn-brand-tagline">Your study companion</span>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="@CloseDrawer" title="Close navigation" />
            </div>

            <!-- Navigation -->
            <div class="sn-drawer-body d-flex flex-column">
                <NavMenu OnLinkClick="@CloseDrawer" />
            </div>

            <div class="sn-drawer-footer">
                <MudText Typo="Typo.caption">StudyNotes v1.0 &middot; Minimalist organizer</MudText>
            </div>
        </div>
    </MudDrawer>

    <!-- Main Content Body -->
    <MudMainContent Class="sn-main-content">
        <div class="sn-content-shell">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

