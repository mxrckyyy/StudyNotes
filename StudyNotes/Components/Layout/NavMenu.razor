@inject NavigationManager NavigationManager

<div class="sn-nav d-flex flex-column flex-grow-1">
    <!-- Main Links Section -->
    <div class="sn-nav-section-label">Menu</div>
    <MudNavMenu Class="px-1">
        <MudNavLink Href="/" Match="NavLinkMatch.All" OnClick='() => NavigateTo("/")' Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit">Dashboard</MudNavLink>
        <MudNavLink Href="/notes" OnClick='() => NavigateTo("/notes")' Icon="@Icons.Material.Filled.Description" IconColor="Color.Inherit">All Notes</MudNavLink>
        <MudNavLink Href="/pinned" OnClick='() => NavigateTo("/pinned")' Icon="@Icons.Material.Filled.PushPin" IconColor="Color.Inherit">Pinned</MudNavLink>
        <MudNavLink Href="/favorites" OnClick='() => NavigateTo("/favorites")' Icon="@Icons.Material.Filled.Star" IconColor="Color.Inherit">Favorites</MudNavLink>
        <MudNavLink Href="/subjects" OnClick='() => NavigateTo("/subjects")' Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Inherit">Subjects</MudNavLink>
    </MudNavMenu>

    <!-- Bottom Links Section -->
    <div class="mt-auto">
        <div class="sn-nav-section-label">General</div>
        <MudNavMenu Class="px-1">
            <MudNavLink Href="/settings" OnClick='() => NavigateTo("/settings")' Icon="@Icons.Material.Filled.Settings" IconColor="Color.Inherit">Settings</MudNavLink>
        </MudNavMenu>

        <!-- Interactive Profile Widget -->
        <div class="sn-profile" @onclick='() => NavigateTo("/")'>
            <div class="sn-profile-avatar">S</div>
            <div class="d-flex flex-column my-auto">
                <span class="sn-profile-name">Student</span>
                <span class="sn-profile-caption">My Account</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnLinkClick { get; set; }

    private async Task NavigateTo(string uri)
    {
        NavigationManager.NavigateTo(uri);

        if (OnLinkClick.HasDelegate)
        {
            await OnLinkClick.InvokeAsync();
        }
    }
}