@inject NavigationManager NavigationManager

<div class="sn-nav d-flex flex-column flex-grow-1">
    <!-- Main Links Section -->
    <div class="sn-nav-section-label">Menu</div>
    <MudNavMenu Class="px-1">
        <MudNavLink Href="/" Match="NavLinkMatch.All" OnClick="CloseDrawer" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit">Dashboard</MudNavLink>
        <MudNavLink Href="/notes" OnClick="CloseDrawer" Icon="@Icons.Material.Filled.Description" IconColor="Color.Inherit">All Notes</MudNavLink>
        <MudNavLink Href="/pinned" OnClick="CloseDrawer" Icon="@Icons.Material.Filled.PushPin" IconColor="Color.Inherit">Pinned</MudNavLink>
        <MudNavLink Href="/favorites" OnClick="CloseDrawer" Icon="@Icons.Material.Filled.Star" IconColor="Color.Inherit">Favorites</MudNavLink>
        <MudNavLink Href="/subjects" OnClick="CloseDrawer" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Inherit">Subjects</MudNavLink>
    </MudNavMenu>

    <!-- Bottom Links Section -->
    <div class="mt-auto">
        <div class="sn-nav-section-label">General</div>
        <MudNavMenu Class="px-1">
            <MudNavLink Href="/settings" OnClick="CloseDrawer" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Inherit">Settings</MudNavLink>
        </MudNavMenu>

        <!-- Interactive Profile Widget -->
        <div class="sn-profile" @onclick="OpenProfile" role="button" tabindex="0" aria-label="My Account">
            <div class="sn-profile-avatar">S</div>
            <div class="d-flex flex-column my-auto">
                <span class="sn-profile-name">Student</span>
                <span class="sn-profile-caption">My Account</span>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnLinkClick { get; set; }

    // Every navigation item (including the profile widget) closes the temporary
    // drawer, so selecting an item on mobile/tablet never leaves the overlay
    // provider covering the page. Clicking the drawer's backdrop also closes it
    // (MudBlazor's DrawerVariant.Temporary behavior).
    private async Task CloseDrawer()
    {
        if (OnLinkClick.HasDelegate)
        {
            await OnLinkClick.InvokeAsync();
        }
    }

    private async Task OpenProfile()
    {
        NavigationManager.NavigateTo("/");
        await CloseDrawer();
    }
}