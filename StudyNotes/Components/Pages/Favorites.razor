@page "/favorites"
@inject NoteService NoteService

<MudText Typo="Typo.h4" Class="font-weight-bold mb-6">Favorite Notes</MudText>

@if (!favoriteNotes.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.Star" Title="No favorite notes yet" Message="Favorite notes that you want to access quickly." />
}
else
{
    <MudGrid GutterSize="GutterSize.Small">
        @foreach (var note in favoriteNotes)
        {
            <MudItem xs="12" sm="6" md="4">
                <NoteCard Note="note" OnChanged="LoadFavorites" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Note> favoriteNotes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFavorites();
    }

    private async Task LoadFavorites()
    {
        favoriteNotes = await NoteService.GetFavoriteNotesAsync();
    }
}