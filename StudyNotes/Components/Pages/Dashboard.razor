@page "/"
@inject NoteService NoteService
@inject SubjectService SubjectService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<!-- Header Row: title left, action button far right -->
<div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-6">
    <div class="sn-page-heading">
        <MudText Typo="Typo.h4" Class="sn-page-title">Dashboard</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="sn-page-subtitle">Welcome back! Here's an overview of your study notes.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateNoteDialog">
        New Note
    </MudButton>
</div>

<!-- Quick Stats Summary Cards -->
@if (_pageLoaded)
{
    <div class="sn-grid mb-6">
        <StatCard Value="@totalNotesCount" Title="Total Notes" Icon="@Icons.Material.Filled.Description" Tone="primary" />
        <StatCard Value="@pinnedNotesCount" Title="Pinned Notes" Icon="@Icons.Material.Filled.PushPin" Tone="warning" />
        <StatCard Value="@totalSubjectsCount" Title="Subjects" Icon="@Icons.Material.Filled.Bookmark" Tone="success" />
    </div>

    <!-- Recent Notes Section -->
    <div class="sn-section-head">
        <MudText Typo="Typo.h6" Class="sn-section-title">Recent Notes</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => NavigationManager.NavigateTo("/notes"))">View all</MudButton>
    </div>

    @if (recentNotes == null || !recentNotes.Any())
    {
        <EmptyState Icon="@Icons.Material.Filled.Description" Title="No Notes Yet" Message="Click '+ New Note' to create your first study note." />
    }
    else
    {
        <div class="sn-grid">
            @foreach (var note in recentNotes)
            {
                <NoteCard Note="note" />
            }
        </div>
    }
}
else
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-6" />
}

@code {
    private List<Note> recentNotes = new();
    private int totalNotesCount;
    private int pinnedNotesCount;
    private int totalSubjectsCount;
    private bool _pageLoaded;

    // Keep the initial render synchronous and fast so navigation feels
    // instant; fetch data only after the first frame has been flushed to
    // the client (the progress bar shows immediate feedback meanwhile).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_pageLoaded)
        {
            _pageLoaded = true;
            StateHasChanged();
            await LoadDashboardData();
            StateHasChanged();
        }
    }

    private async Task LoadDashboardData()
    {
        var allNotes = await NoteService.GetAllNotesAsync();
        var allSubjects = await SubjectService.GetAllSubjectsAsync();

        totalNotesCount = allNotes.Count;
        pinnedNotesCount = allNotes.Count(n => n.IsPinned);
        totalSubjectsCount = allSubjects.Count;
        recentNotes = allNotes.OrderByDescending(n => n.CreatedAt).Take(6).ToList();
    }

    private async Task OpenCreateNoteDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateNoteDialog>("New Note", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (dialog != null)
            await dialog.Result;
    }
}