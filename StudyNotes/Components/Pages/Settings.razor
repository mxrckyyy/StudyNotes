@page "/settings"

<MudText Typo="Typo.h4" Class="font-weight-bold mb-6">Settings</MudText>

<MudPaper Class="pa-6" Elevation="0" Outlined="true" Style="border-radius: 12px;">
    <MudText Typo="Typo.h6" Class="font-weight-bold mb-4">Student Profile</MudText>

    <MudTextField Label="Student Name" Value="@("Student")" Variant="Variant.Outlined" Class="mb-4" ReadOnly="true" />
    <MudTextField Label="Database Storage" Value="@("SQLite (studynotes.db)")" Variant="Variant.Outlined" Class="mb-6" ReadOnly="true" />

    <MudText Typo="Typo.subtitle2" Class="mb-2">Application Details</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">StudyNotes v1.0 — Minimalist Student Notes Organizer</MudText>
</MudPaper>