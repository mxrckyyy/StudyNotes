@page "/subjects"
@inject SubjectService SubjectService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="sn-page-heading mb-6">
    <MudText Typo="Typo.h4" Class="sn-page-title">Subjects</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="sn-page-subtitle">Group your notes by subject to find things faster.</MudText>
</div>

<!-- Add subject -->
<MudPaper Elevation="0" Outlined="true" Class="sn-card pa-5 mb-7" Style="max-width: 720px;">
    <EditForm Model="newSubject" OnValidSubmit="AddSubject">
        <DataAnnotationsValidator />
        <div class="d-flex flex-wrap align-center gap-4">
            <MudTextField T="string" Class="flex-grow-1" Style="min-width: 240px;"
                          Label="Add New Subject" @bind-Value="newSubject.Name" Variant="Variant.Outlined"
                          Required="true" RequiredError="Subject name is required." />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Style="height: 56px; padding: 0 24px;">
                Add Subject
            </MudButton>
        </div>
    </EditForm>
</MudPaper>

@if (!subjects.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.Book" Title="No Subjects Yet" Message="Add subjects to start categorizing your study notes." />
}
else
{
    <div class="sn-grid">
        @foreach (var subject in subjects)
        {
            <MudPaper Elevation="0" Outlined="true" Class="sn-card sn-card-hover pa-4 d-flex justify-space-between align-center">
                <div class="d-flex align-center" style="gap: 14px; min-width: 0;">
                    <div class="sn-subject-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Book" Size="Size.Medium" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold sn-clamp-2">@subject.Name</MudText>
                        <div class="d-flex align-center gap-2 mt-1">
                            <span class="sn-count-pill">@(subject.Notes?.Count ?? 0)</span>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@(subject.Notes?.Count == 1 ? "note" : "notes")</MudText>
                        </div>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="sn-action-danger" OnClick="@(() => DeleteSubject(subject))" title="Delete subject" />
            </MudPaper>
        }
    </div>
}

@code {
    private List<Subject> subjects = new();
    private Subject newSubject = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSubjects();
    }

    private async Task LoadSubjects()
    {
        subjects = await SubjectService.GetAllSubjectsAsync();
    }

    private async Task AddSubject()
    {
        await SubjectService.SaveSubjectAsync(newSubject);
        Snackbar.Add("✓ Subject added!", Severity.Success);
        newSubject = new Subject();
        await LoadSubjects();
    }

    private async Task DeleteSubject(Subject subject)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete the subject \"{subject.Name}\"?",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Subject?", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await SubjectService.DeleteSubjectAsync(subject.Id);
            Snackbar.Add("✓ Subject deleted.", Severity.Info);
            await LoadSubjects();
        }
    }
}