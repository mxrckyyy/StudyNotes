@page "/notes/{Id:int}"
@inject NoteService NoteService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<div class="mb-5">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Back" Variant="Variant.Text" Color="Color.Default" Class="pl-0 mb-3">Back to Notes</MudButton>
</div>

@if (note == null)
{
    <MudProgressCircular Indeterminate="true" Class="d-block mx-auto mt-8" />
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="sn-card pa-7" Style="max-width: 820px;">
        <!-- Title + actions -->
        <div class="d-flex flex-wrap justify-space-between align-start gap-4 mb-4">
            <MudText Typo="Typo.h3" Class="sn-page-title">@note.Title</MudText>

            <div class="d-flex align-center flex-shrink-0" style="gap: 6px;">
                <MudIconButton Icon="@(note.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                               Color="@(note.IsPinned ? Color.Primary : Color.Default)"
                               title="@(note.IsPinned ? "Unpin note" : "Pin note")"
                               OnClick="TogglePin" />
                <MudIconButton Icon="@(note.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                               Color="@(note.IsFavorite ? Color.Warning : Color.Default)"
                               title="@(note.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                               OnClick="ToggleFavorite" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="EditNote" StartIcon="@Icons.Material.Filled.Edit" Class="ml-2">Edit</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="DeleteNote" StartIcon="@Icons.Material.Filled.Delete" Class="sn-btn-danger ml-1">Delete</MudButton>
            </div>
        </div>

        <!-- Metadata row -->
        <div class="sn-meta-row mb-6">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">@(note.Subject?.Name ?? "Unassigned")</MudChip>
            <span class="sn-note-meta">Created @note.CreatedAt.ToString("MMM d, yyyy")</span>
            <span class="sn-note-meta">Updated @note.UpdatedAt.ToString("MMM d, yyyy")</span>
        </div>

        <MudDivider Class="mb-6" />

        <!-- Reading content -->
        <MudText Typo="Typo.body1" Class="sn-reading mb-8">@note.Content</MudText>

        @if (!string.IsNullOrEmpty(note.Tags))
        {
            <div class="mb-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">Tags</MudText>
                <div>
                    @foreach (var tag in note.Tags.Split(new[] { ' ', ',' }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="sn-tag-chip">@tag</span>
                    }
                </div>
            </div>
        }
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }
    private Note? note;

    protected override async Task OnInitializedAsync()
    {
        await LoadNote();
    }

    private async Task LoadNote()
    {
        note = await NoteService.GetNoteByIdAsync(Id);
    }

    private async Task TogglePin()
    {
        if (note == null) return;
        await NoteService.TogglePinAsync(note.Id);
        Snackbar.Add(note.IsPinned ? "✓ Note unpinned." : "✓ Note pinned.", Severity.Info);
        await LoadNote();
    }

    private async Task ToggleFavorite()
    {
        if (note == null) return;
        await NoteService.ToggleFavoriteAsync(note.Id);
        Snackbar.Add(note.IsFavorite ? "✓ Removed from favorites." : "✓ Added to favorites.", Severity.Info);
        await LoadNote();
    }

    private async Task DeleteNote()
    {
        if (note == null) return;

        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete \"{note.Title}\"? This action cannot be undone.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Note?", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await NoteService.DeleteNoteAsync(note.Id);
            Snackbar.Add("✓ Note deleted.", Severity.Success);
            Navigation.NavigateTo("/notes");
        }
    }

    private void EditNote() => Navigation.NavigateTo($"/notes/{Id}/edit");
    private void Back() => Navigation.NavigateTo("/notes");
}