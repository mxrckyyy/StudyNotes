@page "/pinned"
@inject NoteService NoteService

<div class="sn-page-heading mb-6">
    <MudText Typo="Typo.h4" Class="sn-page-title">Pinned Notes</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="sn-page-subtitle">Important notes kept at the top of your mind.</MudText>
</div>

@if (!pinnedNotes.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.PushPin" Title="No pinned notes yet" Message="Pin important notes so you can find them quickly." />
}
else
{
    <div class="sn-grid">
        @foreach (var note in pinnedNotes)
        {
            <NoteCard Note="note" OnChanged="LoadPinned" />
        }
    </div>
}

@code {
    private List<Note> pinnedNotes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPinned();
    }

    private async Task LoadPinned()
    {
        pinnedNotes = await NoteService.GetPinnedNotesAsync();
    }
}